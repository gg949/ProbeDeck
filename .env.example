# ===================== ProbeDeck 环境变量 =====================
# （CF-Server-Monitor 的 Docker/VPS 移植版）
# 用法：复制为 .env 后按需修改（docker compose 会自动读取），
# 或直接在 docker run / docker-compose.yml 中传入。
# 全部变量都有合理默认值——不配置任何变量也能直接启动。

# 探针上报密钥 + 管理面板初始密码（用户名 admin）。
# 不设置则首次启动自动生成，并打印在启动日志 / 保存到 data/api_secret.txt。
# API_SECRET=改成你自己的随机密钥

# 监听端口（容器内），默认 17986
# PORT=17986

# 宿主机映射端口（对外访问用的端口，改这个来换端口，默认 17986）
# HOST_PORT=17986

# 管理面板用户名（默认 admin）
# API_USER_NAME=admin

# 历史数据保留天数（默认 14）。
# 想保留更久改大（例如 30 = 约一个月），想更省空间改小。
# 原理：内部按"轮换周期 = 该值的一半"自动清理旧数据。
# HISTORY_RETENTION_DAYS=14

# 同一台服务器两次历史落库的最小间隔（毫秒，默认 500）。
# 服务端加固：持有密钥的异常探针高频上报时，超出间隔的上报只丢弃历史写入，
# 最新状态与前端实时推送照常、探针仍收到 2xx；正常探针最密 1 秒一报，不受影响。
# 填 0 可完全关闭该闸门。
# REPORT_MIN_WRITE_INTERVAL_MS=500

# 探针 WSS 连接完成首次有效鉴权前的寿命（毫秒，默认 60000）。
# 服务端加固：探针握手阶段没有凭证（密钥在首条上报帧里才校验），超时仍未上报过的
# 匿名连接会被主动断开，避免长期占用连接额度与内存。正常探针连上后 1–5 秒内必上报，
# 不受影响；填 0 可关闭。
# AGENT_WS_AUTH_TIMEOUT_MS=60000

# 地区自动识别：maxmind（默认，本地数据库）/ ipinfo（在线查询）/ off（关闭）
# GEOIP_PROVIDER=maxmind

# 自定义 IP 数据库路径（可选）：
#   把 .mmdb 文件挂载进容器后指向它，例如 /app/data/geoip/custom.mmdb；
#   直接把 GeoLite2-Country.mmdb 放进 ./data/geoip/ 目录也会被自动识别。
# GEOIP_MMDB_PATH=

# ipinfo.io token（可选，GEOIP_PROVIDER=ipinfo 时提高额度）
# IPINFO_TOKEN=

# 允许跨域的来源，多个用英文逗号分隔（同域部署无需设置）
# CORS_ALLOWED_ORIGINS=https://monitor.example.com

# 调试日志（设为 1 打开）
# DEBUG=1
